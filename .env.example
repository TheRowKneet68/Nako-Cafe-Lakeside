# ---------------------------------------------------------------
# Supabase (OPTIONAL backend)
# Leave EMPTY to run fully offline — the app persists data to
# localStorage instead. When set, menu/gallery/reviews/reservations
# read & write to the corresponding Supabase tables.
# See supabase/schema.sql to create the tables.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# EmailJS (OPTIONAL — powers Contact + Reservation emails)
# Leave EMPTY to keep forms working (they simulate a successful send).
# ---------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------
# Admin login (defaults shown below)
# ---------------------------------------------------------------
VITE_ADMIN_EMAIL=admin@viewside.com
VITE_ADMIN_PASSWORD=admin123
