#  Supabase (REQUIRED for production backend) 
# 1. Create a free project at https://supabase.com
# 2. Open SQL Editor and run the file `supabase/schema.sql`
# 3. Enable Auth > Providers > Email
# 4. Add an admin user under Auth > Users (used to sign in at /admin)
# 5. Copy the project URL + ANON key here.
#    IMPORTANT: use the "anon" public key, NEVER the service_role key.
#    The service_role key bypasses Row Level Security and must never be
#    placed in client-side code or committed to the repository.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key




# ---------------------------------------------------------------
# Admin login
# REQUIRED for the live site. In a production build the admin panel
# FAILS CLOSED — nobody can sign in until these are set (e.g. in the
# Vercel project settings). In local development (npm run dev) the
# fallback demo account (admin@nakocafe.com.np / admin123) still works.
# If you connect Supabase below, these are ignored — staff sign in with
# their Supabase Auth account and their ncl_profiles role instead.
# ---------------------------------------------------------------
VITE_ADMIN_EMAIL=admin@nako.com
VITE_ADMIN_PASSWORD=nako-admin
