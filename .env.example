# ---------------------------------------------------------------
# Supabase (OPTIONAL backend)
# Leave EMPTY to run fully offline — the app persists data to
# localStorage instead. When set, menu/gallery/reviews/reservations
# read & write to the corresponding Supabase tables.
# See supabase/schema.sql to create the tables.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# EmailJS (OPTIONAL — powers Contact + Reservation emails)
# Leave EMPTY to keep forms working (they simulate a successful send).
# ---------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------
# Admin login
# REQUIRED for the live site. In a production build the admin panel
# FAILS CLOSED — nobody can sign in until these are set (e.g. in the
# Vercel project settings). In local development (npm run dev) the
# fallback demo account (admin@nakocafe.com.np / admin123) still works.
# If you connect Supabase below, these are ignored — staff sign in with
# their Supabase Auth account and their ncl_profiles role instead.
# ---------------------------------------------------------------
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
